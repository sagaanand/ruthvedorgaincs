# ============================================================
# Ruthved Organic Backend Environment Configuration
# ============================================================

# App Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Logging
LOG_LEVEL=info

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ruthved_organic?schema=public"

# Redis & Background Jobs (BullMQ)
REDIS_URL="redis://localhost:6379"
ENABLE_REDIS_JOBS=false

# Authentication & JWT Secrets
JWT_ACCESS_SECRET="ruthved_super_secret_access_jwt_key_minimum_32_characters_long_12345"
JWT_REFRESH_SECRET="ruthved_super_secret_refresh_jwt_key_minimum_32_characters_long_67890"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
COOKIE_SECRET="ruthved_cookie_secret_key_random_string_32_chars"

# Password Hashing Cost
BCRYPT_SALT_ROUNDS=10

# Razorpay Payment Gateway (Indian Online Payments)
RAZORPAY_KEY_ID="rzp_test_YourTestKeyIdHere"
RAZORPAY_KEY_SECRET="YourTestKeySecretHere"
RAZORPAY_WEBHOOK_SECRET="YourWebhookSecretHere"

# File Storage Configuration (S3 or Local)
# Options: 'local' | 's3'
STORAGE_DRIVER=local
UPLOAD_DIR="./uploads"
# S3 Configuration (AWS S3, Cloudflare R2, MinIO, or DigitalOcean Spaces)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="ruthved-assets"
AWS_S3_ENDPOINT=""

# Email Notifications (SMTP / Nodemailer)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="orders@ruthvedorganic.com"
SMTP_PASS="your_smtp_app_password"
EMAIL_FROM_NAME="Ruthved Organic"
EMAIL_FROM_ADDRESS="orders@ruthvedorganic.com"

# WhatsApp Notifications (Meta WhatsApp Cloud API)
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_TEMPLATE_NAMESPACE=""

# Business & Store Defaults
DEFAULT_CURRENCY="INR"
FREE_SHIPPING_THRESHOLD=750
STANDARD_SHIPPING_FEE=70
DEFAULT_TAX_RATE=0.05
